// Order Change Control models — specs/016-change-control/data-model.md
// Multi-file Prisma schema (prismaSchemaFolder preview feature).
// Relations to models in core.prisma and identity.prisma resolve transparently.

// --- Enums -----------------------------------------------------------------

/// research.md §1/§2. Origin of a specification version (FR-002).
enum SpecVersionOrigin {
  INITIAL // created with the Work Item (011 creation paths)
  BACKFILL // migration backfill or runtime self-heal (FR-005); createdById = null
  DIRECT_EDIT // editSpec / 011 editWorkItem (US2)
  CHANGE_REQUEST // approveChangeRequest (US3)
  ADMIN_OVERRIDE // adminOverrideSpec (US7)
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
  CLOSED_BY_CANCELLATION
}

enum ChangeRequestOutcome {
  CONTINUE_PRODUCTION
  REDESIGN
}

// --- Models ----------------------------------------------------------------

/// One immutable specification snapshot. Append-only: REVOKE UPDATE, DELETE
/// (manual-sql/016-change-control-constraints.sql). Columns mirror WorkItem's
/// 011 descriptive fields exactly (types, precision, enum).
model SpecVersion {
  id         String            @id @default(cuid())
  workItemId String
  workItem   WorkItem          @relation("WorkItemSpecVersions", fields: [workItemId], references: [id])
  /// 1, 2, 3 … per Work Item, never reused.
  version    Int
  origin     SpecVersionOrigin

  productTypeId String?
  productType   ProductType?           @relation("SpecVersionProductType", fields: [productTypeId], references: [id])
  description   String?
  quantity      Int?
  widthValue    Decimal?               @db.Decimal(10, 2)
  heightValue   Decimal?               @db.Decimal(10, 2)
  dimensionUnit WorkItemDimensionUnit?
  material      String?
  finishNotes   String?

  /// WorkItem.state when this version was created (FR-002).
  stateAtCreation WorkItemState
  /// Required for ADMIN_OVERRIDE and CHANGE_REQUEST (copied from the request); optional otherwise.
  reason          String?
  /// Null only for origin = BACKFILL.
  createdById     String?
  createdBy       User?         @relation("SpecVersionCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())

  /// Back-relations
  currentFor            WorkItem?       @relation("WorkItemCurrentSpecVersion")
  baseOfChangeRequests  ChangeRequest[] @relation("ChangeRequestBaseVersion")
  resultOfChangeRequest ChangeRequest?  @relation("ChangeRequestResultingVersion")

  @@unique([workItemId, version])
}

/// A customer's requested modification to an IN_PRODUCTION Work Item (US3), or
/// the auto-approved record of an in-production Admin override (FR-028).
/// Never deleted. Fields below the divider are written exactly once by the
/// guarded PENDING → terminal update (research.md §13).
model ChangeRequest {
  id                   String              @id @default(cuid())
  workItemId           String
  workItem             WorkItem            @relation(fields: [workItemId], references: [id])
  status               ChangeRequestStatus @default(PENDING)
  baseSpecVersionId    String
  baseSpecVersion      SpecVersion         @relation("ChangeRequestBaseVersion", fields: [baseSpecVersionId], references: [id])
  /// SpecPatch (contracts/change-control.md) — validated by specPatchSchema on
  /// write AND re-parsed on read; never consumed untyped.
  proposedPatch        Json
  requestReason        String
  requestedById        String
  requestedBy          User                @relation("ChangeRequestRequestedBy", fields: [requestedById], references: [id])
  createdAt            DateTime            @default(now())
  /// Set when createChangeRequest closed an open ACTIVE PhaseTiming segment (FR-012).
  pausedRunningTimerAt DateTime?
  isAdminOverride      Boolean             @default(false)

  // ── decision (written once) ─────────────────────────────────────────────
  decidedById            String?
  decidedBy              User?                 @relation("ChangeRequestDecidedBy", fields: [decidedById], references: [id])
  decidedAt              DateTime?
  /// Rejection/withdrawal reason (required then) or approval note (optional).
  decisionNote           String?
  /// Non-null iff status = APPROVED.
  outcome                ChangeRequestOutcome?
  resultingSpecVersionId String?               @unique
  resultingSpecVersion   SpecVersion?          @relation("ChangeRequestResultingVersion", fields: [resultingSpecVersionId], references: [id])
  /// Non-null iff outcome = REDESIGN.
  returnId               String?               @unique
  return                 Return?               @relation(fields: [returnId], references: [id])

  // ── production acknowledgment (outcome = CONTINUE_PRODUCTION only) ──────
  productionAcknowledgedAt   DateTime?
  productionAcknowledgedById String?
  productionAcknowledgedBy   User?     @relation("ChangeRequestAcknowledgedBy", fields: [productionAcknowledgedById], references: [id])

  @@index([workItemId, status])
  @@index([status, createdAt])
}

/// Permanent record of a cancellation after production started (US6). Source
/// record for 052's direct cost (PRD §30). Append-only (REVOKE UPDATE, DELETE).
model LateCancellation {
  id                    String        @id @default(cuid())
  workItemId            String        @unique
  workItem              WorkItem      @relation(fields: [workItemId], references: [id])
  stateAtCancellation   WorkItemState
  reason                String
  /// Exact decimal, >= 0, entered explicitly (FR-024).
  costIncurred          Decimal       @db.Decimal(12, 2)
  /// Configured column, default EGP (constitution VI) — not a UI constant.
  currency              String        @default("EGP")
  producedQuantitySoFar Int?
  costNote              String?
  createdById           String
  createdBy             User          @relation("LateCancellationCreatedBy", fields: [createdById], references: [id])
  createdAt             DateTime      @default(now())
}

// Core domain models — the Order → WorkItem canonical model (constitution I).
// Source of truth: specs/002-core-domain-shell/data-model.md
// Relations to `User` (identity.prisma) work directly across schema files —
// Prisma's multi-file schema (prismaSchemaFolder) requires no import.

// --- Enums -----------------------------------------------------------------

enum WorkItemState {
  NEW
  ASSIGNED
  IN_DESIGN
  DESIGN_COMPLETED
  WAITING_REVIEW
  REWORK_REQUIRED
  APPROVED
  WAITING_PRICING
  READY_FOR_PRODUCTION
  IN_PRODUCTION
  PRODUCTION_COMPLETED
  READY_FOR_COLLECTION
  DELIVERED
  COMPLETED
  CANCELLED
}

enum OrderChannel {
  WALK_IN
  WHATSAPP
  PHONE
  RETURNING
  DIRECT_TO_DESIGNER
}

enum OrderPriority {
  NORMAL
  URGENT
}

enum OrderMode {
  GROUPED
  SEPARATE
}

enum PhaseTimingKind {
  QUEUE
  ACTIVE
}

enum RejectionCategory {
  DESIGN_ISSUE
  DIMENSION_ISSUE
  CUSTOMER_CHANGE
  PRICING_ISSUE
  ACCOUNTING_ISSUE
  PRODUCTION_ISSUE
  MISSING_INFORMATION
  OTHER
}

enum WorkItemDimensionUnit {
  MM
  CM
  M
  IN
}

enum ReturnAttachmentKind {
  VOICE_NOTE
  IMAGE
  FILE
}

// --- Models ------------------------------------------------------------

/// Admin-configured production department (constitution VI: data, not an enum).
model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  /// Configured flag (constitution VI), not a hardcoded department-name
  /// check (014 research.md §5, US6).
  isExternalProduction Boolean @default(false)

  workItems       WorkItem[]
  returns         Return[]
  // Back-relation for 001-identity-access-audit's UserDepartment join
  // (identity.prisma). Cross-file relations work transparently with
  // prismaSchemaFolder — no import needed.
  userDepartments UserDepartment[]
  // Back-relation for 011-orders-reception's ProductType.defaultDepartmentId.
  productTypes    ProductType[]
}

model Customer {
  id               String   @id @default(cuid())
  name             String
  normalizedName   String   @default("")
  nationalId       String?
  notes            String?
  isCashCustomer   Boolean  @default(false)
  isArchived       Boolean  @default(false)
  classificationId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orders         Order[]
  phones         CustomerPhone[]
  addresses      CustomerAddress[]
  classification CustomerClassification? @relation(fields: [classificationId], references: [id])
  promotionsFrom CustomerPromotion[]     @relation("PromotionSource")
  promotionsTo   CustomerPromotion[]     @relation("PromotionTarget")
  pricingRules   CustomerPricingRule[]
  // --- 052-finance reverse relations ---
  payments       Payment[]
  customerCredit CustomerCredit?

  @@index([normalizedName])
  @@index([isArchived])
}

model Order {
  id          String        @id @default(cuid())
  /// DB sequence, ever-increasing, no reset, no prefix (FR-008a).
  number      Int           @unique @default(autoincrement())
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])
  channel     OrderChannel
  priority    OrderPriority
  mode        OrderMode
  /// Optional default due date for any Work Item on this order that has no
  /// due date of its own set (011 spec FR-003a).
  dueDate     DateTime?
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  workItems   WorkItem[]
  // --- 052-finance reverse relations ---
  payments    Payment[]
  expenses    Expense[]
  directCosts DirectCost[]

  // Status is NOT a column — see contracts/orders.md (deriveOrderStatus).

  @@index([customerId])
}

model WorkItem {
  id             String        @id @default(cuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id])
  /// Catalog owned by 011.
  productTypeId  String?
  productType    ProductType?  @relation(fields: [productTypeId], references: [id])
  departmentId   String?
  department     Department?   @relation(fields: [departmentId], references: [id])
  /// Written only by transitionWorkItem().
  state          WorkItemState
  requiresDesign Boolean       @default(true)
  requiresReview Boolean       @default(true)
  assigneeId     String?
  assignee       User?         @relation("WorkItemAssignee", fields: [assigneeId], references: [id])

  /// --- 011-orders-reception descriptive fields --------------------------
  description   String?
  quantity      Int?
  widthValue    Decimal?               @db.Decimal(10, 2)
  heightValue   Decimal?               @db.Decimal(10, 2)
  dimensionUnit WorkItemDimensionUnit?
  material      String?
  finishNotes   String?
  /// Per-item due date override — null means "use Order.dueDate" (FR-003a).
  dueDate       DateTime?
  /// --- end 011-orders-reception fields -----------------------------------

  /// --- 014-production fields ---------------------------------------------
  /// Set on completion (US4, FR-006/FR-007). Required by completeProduction();
  /// validated non-null and > 0 before the completion transition runs.
  producedQuantity      Int?
  /// Optional free-text notes recorded at completion.
  productionNotes       String?
  /// Non-null while a newer DesignVersion was approved during IN_PRODUCTION
  /// and the operator has not yet acknowledged it (US7, FR-013). Set by the
  /// approval path (013's approveDesign), cleared by acknowledgeFileRevision().
  /// research.md §4 — a plain field, not a guard.
  pendingFileRevisionAt DateTime?
  /// --- end 014-production fields -------------------------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// --- 016-change-control ------------------------------------------------
  /// Current SpecVersion. Nullable only for the circular insert and the
  /// window before backfill (research.md §14); non-null for every Work Item
  /// after backfill (verified by query + contract test).
  currentSpecVersionId String?           @unique
  currentSpecVersion   SpecVersion?      @relation("WorkItemCurrentSpecVersion", fields: [currentSpecVersionId], references: [id])
  specVersions         SpecVersion[]     @relation("WorkItemSpecVersions")
  changeRequests       ChangeRequest[]
  lateCancellation     LateCancellation?
  /// --- end 016-change-control ---------------------------------------------

  transitions             WorkItemTransition[]
  phaseTimings            PhaseTiming[]
  designVersions          DesignVersion[]
  returns                 Return[]
  vendorProductionRecords VendorProductionRecord[]
  fileAssets              FileAsset[]              @relation("FileAssetWorkItem")
  prices                  WorkItemPrice[]
  pricingStatus           PricingStatus?
  // --- 052-finance reverse relations ---
  expenses                Expense[]
  directCosts             DirectCost[]
  // --- 053-notifications reverse relation ---
  delayBreaches           DelayBreach[]

  @@index([orderId, state])
  // Review queue (getReviewQueue) filters on `state` alone; My Queue /
  // designer workload / eligible-designers filter on `assigneeId` (+ state).
  // Neither was covered by the existing [orderId, state] index, so both were
  // sequential-scanning the full WorkItem table at this row count.
  @@index([state])
  @@index([assigneeId, state])
}

/// Admin-configured product catalog (constitution VI: data, not an enum).
/// Owned by 011. Referenced by WorkItem.productTypeId.
model ProductType {
  id                    String      @id @default(cuid())
  name                  String      @unique
  defaultDepartmentId   String?
  defaultDepartment     Department? @relation(fields: [defaultDepartmentId], references: [id])
  defaultRequiresDesign Boolean     @default(true)
  defaultRequiresReview Boolean     @default(true)
  /// Free-form hint string for 051 to interpret (e.g. "FIXED" | "VARIABLE"
  /// | "QUOTE") — stored opaquely, not validated against 051's vocabulary.
  pricingModeHint       String?
  isActive              Boolean     @default(true)
  createdAt             DateTime    @default(now())

  workItems            WorkItem[]
  specVersions         SpecVersion[]         @relation("SpecVersionProductType")
  pricingPolicy        ProductPricingPolicy?
  priceLists           PriceList[]
  customerPricingRules CustomerPricingRule[]
}

/// Immutable — application code never updates or deletes a row here (constitution III).
model WorkItemTransition {
  id                String             @id @default(cuid())
  workItemId        String
  workItem          WorkItem           @relation(fields: [workItemId], references: [id])
  from              WorkItemState
  to                WorkItemState
  actorId           String
  actor             User               @relation("WorkItemTransitionActor", fields: [actorId], references: [id])
  at                DateTime           @default(now())
  /// Required by the caller for REWORK_REQUIRED and CANCELLED edges
  /// (enforced in transitionWorkItem, not the schema).
  reason            String?
  /// Set only on edges landing in REWORK_REQUIRED; drives the landing-state
  /// choice (FR-003b).
  rejectionCategory RejectionCategory?
  meta              Json?

  @@index([workItemId, at])
}

/// Timestamped segments, not a stopwatch (constitution III, FR-009).
model PhaseTiming {
  id         String          @id @default(cuid())
  workItemId String
  workItem   WorkItem        @relation(fields: [workItemId], references: [id])
  /// Which state this timing segment belongs to.
  phase      WorkItemState
  /// Null for QUEUE segments (nobody "actively" queues).
  userId     String?
  user       User?           @relation("PhaseTimingUser", fields: [userId], references: [id])
  kind       PhaseTimingKind
  startedAt  DateTime
  /// Null while the segment is open; pausing sets this, resuming starts a
  /// new segment (spec FR-009).
  endedAt    DateTime?

  @@index([workItemId, phase, kind])
}

/// A single uploaded design file version for a Work Item (constitution IV:
/// "new version, never overwritten in place"). Bytes live in the existing
/// StorageAdapter (002); this table is metadata only. Owned by 012.
model DesignVersion {
  id           String   @id @default(cuid())
  workItemId   String
  workItem     WorkItem @relation(fields: [workItemId], references: [id])
  /// 1, 2, 3... per Work Item — never reused, never decremented.
  version      Int
  /// Opaque key passed to StorageAdapter.put/get — no folder/filename
  /// semantics assumed by application code (constitution IV).
  storageKey   String
  fileName     String
  mimeType     String?
  sizeBytes    Int
  sha256       String
  /// Short note the designer attaches (e.g. "v2 — updated logo size").
  note         String?
  uploadedById String
  uploadedBy   User     @relation("DesignVersionUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  /// Set once by 013's approveDesign; never cleared (constitution IV).
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?     @relation("DesignVersionApprovedBy", fields: [approvedById], references: [id])

  returns Return[]

  @@unique([workItemId, version])
  @@index([workItemId, createdAt])
}

/// Generic "sent back" record — 013's own rejection flow creates one, and
/// 014/051 are expected to reuse this same shape for non-review returns
/// (spec.md User Story 6). Immutable — no application code path updates or
/// deletes a row here (constitution III).
model Return {
  id                 String            @id @default(cuid())
  workItemId         String
  workItem           WorkItem          @relation(fields: [workItemId], references: [id])
  raisedById         String
  raisedBy           User              @relation("ReturnRaisedBy", fields: [raisedById], references: [id])
  originDepartmentId String
  originDepartment   Department        @relation(fields: [originDepartmentId], references: [id])
  category           RejectionCategory
  assignedToId       String
  assignedTo         User              @relation("ReturnAssignedTo", fields: [assignedToId], references: [id])
  explanation        String
  note               String?
  /// Nullable — only set when raised from 013's own design-review rejection
  /// flow; a future 014/051-originated return has no design version.
  designVersionId    String?
  designVersion      DesignVersion?    @relation(fields: [designVersionId], references: [id])
  createdAt          DateTime          @default(now())

  attachments   ReturnAttachment[]
  changeRequest ChangeRequest?

  @@index([workItemId, createdAt])
}

model ReturnAttachment {
  id         String               @id @default(cuid())
  returnId   String
  return     Return               @relation(fields: [returnId], references: [id])
  kind       ReturnAttachmentKind
  /// Opaque key passed to StorageAdapter.put/get (constitution IV).
  storageKey String
  fileName   String
  mimeType   String?
  sizeBytes  Int
  createdAt  DateTime             @default(now())

  @@index([returnId])
}

/// One row per external-production cycle, not two separate sent/received
/// event rows (014 research.md §5) — completion's gate check needs a single
/// queryable row testing `receivedAt IS NOT NULL`.
model VendorProductionRecord {
  id          String    @id @default(cuid())
  workItemId  String
  workItem    WorkItem  @relation(fields: [workItemId], references: [id])
  vendorName  String
  sentAt      DateTime  @default(now())
  /// Null until recordReceivedFromVendor() runs; completeProduction() MUST
  /// refuse completion while this is null for a Work Item routed to an
  /// external-production department (FR-012).
  receivedAt  DateTime?
  createdById String
  createdBy   User      @relation("VendorProductionRecordCreatedBy", fields: [createdById], references: [id])

  @@index([workItemId])
}

/// Outbox — polymorphic via entityType/entityId, not a Prisma relation.
model NotificationEvent {
  id                     String          @id @default(cuid())
  /// Event type discriminator, e.g. "work_item.rejected".
  type                   String
  entityType             String
  entityId               String
  recipientUserIds       String[]
  recipientRoles         String[]
  recipientDepartmentIds String[]
  payload                Json?
  createdAt              DateTime        @default(now())
  /// Set once when 053 has fully processed this event; null = unprocessed.
  /// 002 reserved this column for 053; 053 reuses it rather than adding a
  /// parallel marker, so one row has exactly one answer to "was this
  /// delivered?" (003-free — see specs/053-notifications/data-model.md
  /// §NotificationEvent, A-001).
  deliveredAt            DateTime?
  /// PENDING / PROCESSED / FAILED / UNMAPPED. 002 shipped this as `String?`
  /// and never wrote it, so the retype is a safe ALTER (every existing row is
  /// NULL). The migration backfills NULL → PENDING BEFORE adding the claim
  /// index — without it the claim predicate silently skips every event the
  /// live features (012/013/014/015/016) have already recorded.
  deliveryStatus         DeliveryStatus?
  /// 053-only processing columns. No emitter writes these.
  attemptCount           Int             @default(0)
  lastAttemptAt          DateTime?
  lastError              String?
  /// Fourth addressing mode (FR-016, additive to 002's three).
  recipientPermissions   String[]        @default([])

  /// 053's notifications. The outbox row is the delivery audit trail and is
  /// retained after processing (FR-063), so this is a plain reference, never
  /// a cascade.
  notifications Notification[]

  @@index([entityType, entityId])
  @@index([deliveredAt, deliveryStatus, createdAt])
  @@index([type, createdAt])
}

model CustomerPhone {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  phoneE164  String   @unique
  kind       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId, kind])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String?
  value      String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId, isDefault])
}

model CustomerClassification {
  id        String     @id @default(cuid())
  name      String     @unique
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  customers Customer[]
}

model CustomerPromotion {
  id               String    @id @default(cuid())
  sourceCustomerId String
  targetCustomerId String
  orderIds         Json
  reason           String
  performedById    String
  performedAt      DateTime  @default(now())
  reversedAt       DateTime?
  reversedById     String?

  sourceCustomer Customer @relation("PromotionSource", fields: [sourceCustomerId], references: [id])
  targetCustomer Customer @relation("PromotionTarget", fields: [targetCustomerId], references: [id])

  @@index([sourceCustomerId, performedAt])
  @@index([targetCustomerId, performedAt])
}

// File Storage & Versioning models — 050-files
// Source of truth: specs/050-files/data-model.md
// Relations to WorkItem (core.prisma) and User (identity.prisma) work across schema files.

enum FileCategory {
  ORIGINAL
  DESIGN_VERSIONS
  REVIEW_PROOF
  APPROVED
  PRODUCTION
  SUPPORTING
}

enum FileLifecycleStatus {
  ACTIVE
  SUPERSEDED
  VOID
  ARCHIVED
  CORRUPTED
}

enum AttachmentKind {
  VOICE_NOTE
  IMAGE
  FILE
}

enum AuditAction {
  CREATE
  UPDATE
  STATUS_CHANGE
  APPROVE
  VOID
  ARCHIVE
  SUPERSEDE
}

enum AuditEntity {
  FILE_OBJECT
  FILE_ASSET
  FILE_VERSION
  ATTACHMENT
}

/// Immutable physical bytes, deduplicated by checksum (constitution IV).
model FileObject {
  id         String   @id @default(cuid())
  /// Opaque hash/ID-based key; never customer/folder naming. Unique.
  storageKey String   @unique
  /// Required, 0–5 GB inclusive.
  sizeBytes  BigInt
  /// Required 64-hex checksum; unique for deduplication.
  sha256     String   @unique
  /// Required; validated against configured allowlist.
  mimeType   String
  createdAt  DateTime @default(now())

  fileVersions FileVersion[]
  attachments  Attachment[]

  @@index([sha256])
}

/// Logical file attached to one Work Item and category.
model FileAsset {
  id          String       @id @default(cuid())
  workItemId  String
  workItem    WorkItem     @relation("FileAssetWorkItem", fields: [workItemId], references: [id])
  category    FileCategory
  /// Display/grouping name; never storage identity.
  logicalName String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  fileVersions FileVersion[]

  @@unique([workItemId, category, logicalName])
  @@index([workItemId, category])
}

/// Immutable upload metadata pointing to a FileObject.
model FileVersion {
  id            String              @id @default(cuid())
  fileAssetId   String
  fileAsset     FileAsset           @relation(fields: [fileAssetId], references: [id])
  fileObjectId  String
  fileObject    FileObject          @relation(fields: [fileObjectId], references: [id])
  /// Unique per FileAsset, starts at 1, monotonic under concurrency.
  versionNumber Int
  /// Display filename; validated, no path traversal.
  originalName  String
  uploadedById  String
  uploadedBy    User                @relation("DesignVersionUploadedBy", fields: [uploadedById], references: [id])
  /// Optional upload note.
  note          String?
  status        FileLifecycleStatus @default(ACTIVE)
  /// Set only through markApproved; approval owner is 013.
  approved      Boolean             @default(false)
  createdAt     DateTime            @default(now())

  @@unique([fileAssetId, versionNumber])
  @@index([fileAssetId, createdAt])
}

/// Generic link to an operational entity (rejection, discrepancy, expense, audit event, message).
model Attachment {
  id           String              @id @default(cuid())
  fileObjectId String
  fileObject   FileObject          @relation(fields: [fileObjectId], references: [id])
  /// Rejection, discrepancy, expense, audit event, message, or future configured target.
  entityType   String
  /// Target identifier; polymorphic and authorized by owning feature.
  entityId     String
  /// Display name.
  originalName String
  kind         AttachmentKind
  createdById  String
  createdBy    User                @relation("ReturnAttachment", fields: [createdById], references: [id])
  status       FileLifecycleStatus @default(ACTIVE)
  createdAt    DateTime            @default(now())

  @@index([entityType, entityId])
  @@index([fileObjectId])
}

/// Append-only audit trail for all file lifecycle mutations and approvals.
/// Follows 001 audit.record contract.
model FileAuditEvent {
  id           String      @id @default(cuid())
  actorId      String
  actor        User        @relation("WorkItemTransitionActor", fields: [actorId], references: [id])
  action       AuditAction
  entity       AuditEntity
  entityId     String
  beforeValues Json?
  afterValues  Json?
  /// Required for VOID, ARCHIVE, SUPERSEDE, APPROVE.
  reason       String?
  createdAt    DateTime    @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
}

/// Runtime configuration singleton loaded from config/050-files.yaml at startup.
model FileConfig {
  id                   String   @id @default("files-config")
  /// Required array of MIME type patterns; validated on write.
  mimeAllowlist        Json
  /// Required, 1–10 GB inclusive.
  maxFileSizeBytes     BigInt
  /// Required array of { name: string, code: string }; managed by Admin UI.
  departments          Json
  /// Required, 60–3600.
  previewExpirySeconds Int
  updatedAt            DateTime @updatedAt
  updatedById          String
  updatedBy            User     @relation("WorkItemTransitionActor", fields: [updatedById], references: [id])
}

// 052-finance — payments, expenses, direct costs, customer credit, config.
//
// Immutability: Payment / Expense / DirectCost / FinanceVoid / ExpenseApproval
// rows are append-only (constitution III). Corrections are expressed by
// appending a FinanceVoid row; approval by appending an ExpenseApproval row.
// No application code path issues UPDATE/DELETE against these tables, and the
// creating migration raises from BEFORE UPDATE/DELETE triggers (051 pricing
// precedent); scripts/test-db.mjs additionally REVOKEs UPDATE/DELETE from the
// test app role so tests can prove the database refuses too (SC-002).

enum FinanceVoidEntity {
  PAYMENT
  EXPENSE
  DIRECT_COST
}

model Payment {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id])
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  /// Positive Decimal EGP. Never Float (constitution Money).
  amount        Decimal  @db.Decimal(12, 2)
  currency      String   @default("EGP")
  /// Label snapshot of the configured method at record time (FR-003).
  method        String
  /// Label snapshot of the configured source/location at record time.
  source        String
  note          String?
  /// Payment date+time, UTC; <= now at insert (FR-002, FR-027).
  occurredAt    DateTime
  recordedAt    DateTime @default(now())
  recordedById  String
  recordedBy    User     @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  /// Sequential per shop; gaps allowed only from rolled-back allocations
  /// (native autoincrement — Order.number precedent).
  receiptNumber Int      @unique @default(autoincrement())

  @@index([orderId])
  @@index([customerId])
  @@index([occurredAt])
}

/// Appended correction record — the ONLY lifecycle mutation for money rows.
/// @@unique([entityType, entityId]) structurally enforces single-void.
model FinanceVoid {
  id         String            @id @default(cuid())
  entityType FinanceVoidEntity
  entityId   String
  /// Required non-empty; validated before audit.record (001 reason policy).
  reason     String
  voidedById String
  voidedBy   User              @relation("FinanceVoidedBy", fields: [voidedById], references: [id])
  voidedAt   DateTime          @default(now())

  @@unique([entityType, entityId])
  @@index([entityId])
}

model Expense {
  id          String    @id @default(cuid())
  /// Positive Decimal EGP.
  amount      Decimal   @db.Decimal(12, 2)
  /// Label snapshot of the configured category at record time (FR-014).
  category    String
  /// User-chosen calendar date (UTC midnight of that date).
  expenseDate DateTime
  /// Responsible employee display name (PRD §31) — may be a non-user.
  employee    String
  description String
  orderId     String?
  order       Order?    @relation(fields: [orderId], references: [id])
  workItemId  String?
  workItem    WorkItem? @relation(fields: [workItemId], references: [id])
  createdById String
  createdBy   User      @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  approval ExpenseApproval?

  @@index([orderId])
  @@index([expenseDate])
  @@index([category])
}

/// Approval is an appended record — the Expense row itself never changes.
/// At most one approval per expense.
model ExpenseApproval {
  expenseId    String   @id
  expense      Expense  @relation(fields: [expenseId], references: [id])
  approvedById String
  approvedBy   User     @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime @default(now())
}

model DirectCost {
  id          String    @id @default(cuid())
  amount      Decimal   @db.Decimal(12, 2)
  /// User-chosen calendar date (UTC midnight of that date).
  costDate    DateTime
  description String
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id])
  workItemId  String?
  workItem    WorkItem? @relation(fields: [workItemId], references: [id])
  createdById String
  createdBy   User      @relation("DirectCostCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([orderId])
  @@index([workItemId])
}

/// Finance-owned credit standing associated with a customer (FR-010) —
/// NOT a mutation of the 010-owned Customer master row.
model CustomerCredit {
  customerId     String   @id
  customer       Customer @relation(fields: [customerId], references: [id])
  creditApproved Boolean  @default(false)
  /// Warn-only in V1 (Clarifications 2026-09-25) — never blocks anything.
  creditLimit    Decimal? @db.Decimal(12, 2)
  /// Required non-empty reason (052-local policy, validated pre-audit).
  updatedById    String
  updatedBy      User     @relation("CustomerCreditUpdatedBy", fields: [updatedById], references: [id])
  updatedAt      DateTime @updatedAt
}

/// Singleton runtime configuration, seeded from config/052-finance.yaml
/// (FileConfig precedent). Money rows keep label snapshots — history is
/// unaffected by config edits.
model FinanceConfig {
  id                String   @id @default("finance-config")
  paymentMethods    Json
  paymentSources    Json
  /// [{ label: string, active: boolean }]
  expenseCategories Json
  approvalThreshold Decimal  @db.Decimal(12, 2)
  shopTimezone      String   @default("Africa/Cairo")
  updatedById       String
  updatedBy         User     @relation("FinanceConfigUpdatedBy", fields: [updatedById], references: [id])
  updatedAt         DateTime @updatedAt
}

// Better Auth models — moved as-is from the original single-file schema.
// Owned in practice by feature 001 going forward.
// Extended by 001-identity-access-audit: username plugin fields, lockout
// columns, RBAC models (Role/RolePermission/UserRole/UserPermission/
// UserDepartment), and AuditEvent.
// learn more: https://better-auth.com/docs/concepts/database

// NOTE: When using mysql or sqlserver, uncomment the //@db.Text annotations in model Account below
// Further reading:
// https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string

model User {
  id            String   @id
  name          String //@db.Text
  email         String
  emailVerified Boolean  @default(false)
  image         String? //@db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  // --- Better Auth username plugin fields (001-identity-access-audit) ---
  // Login identifier. Populated at account-creation time; never shown in
  // the UI as the email (which stays as a synthetic placeholder per
  // research.md: "{username}@local.invalid").
  username        String  @unique
  // Preserves original casing of the username for display purposes while
  // the canonical `username` is stored lower-cased for case-insensitive
  // lookup (Better Auth username plugin convention).
  displayUsername String?

  // --- Deactivation / lockout fields (001-identity-access-audit) ---
  // FR-015: users are never hard-deleted — only deactivated/reactivated.
  isActive            Boolean   @default(true)
  // FR-004: failed-attempt counter; reset to 0 on any successful login.
  failedLoginAttempts Int       @default(0)
  // FR-004: set to now+15 min on the 5th consecutive failure; login is
  // rejected while this is in the future.
  lockedUntil         DateTime?

  // --- Better Auth core relations ---
  sessions Session[]
  accounts Account[]

  // --- RBAC relations (001-identity-access-audit) ---
  roles              UserRole[]
  extraPermissions   UserPermission[]
  departments        UserDepartment[]
  auditEvents        AuditEvent[]
  // Back-reference: UserPermission rows this user granted to others.
  grantedPermissions UserPermission[] @relation("PermissionGrantedBy")

  // --- Reverse relations to core.prisma domain models (multi-file schema —
  // no import needed; owned in practice by 002-core-domain-shell). ---
  createdOrders                  Order[]                    @relation
  assignedWorkItems              WorkItem[]                 @relation("WorkItemAssignee")
  workItemTransitions            WorkItemTransition[]       @relation("WorkItemTransitionActor")
  phaseTimings                   PhaseTiming[]              @relation("PhaseTimingUser")
  designVersionsUploaded         DesignVersion[]            @relation("DesignVersionUploadedBy")
  designVersionsApproved         DesignVersion[]            @relation("DesignVersionApprovedBy")
  returnsRaised                  Return[]                   @relation("ReturnRaisedBy")
  returnsAssignedToMe            Return[]                   @relation("ReturnAssignedTo")
  vendorProductionRecordsCreated VendorProductionRecord[]   @relation("VendorProductionRecordCreatedBy")
  fileVersionsUploaded           FileVersion[]              @relation("DesignVersionUploadedBy")
  attachments                    Attachment[]               @relation("ReturnAttachment")
  fileAuditEvents                FileAuditEvent[]           @relation("WorkItemTransitionActor")
  fileConfigsUpdated             FileConfig[]               @relation("WorkItemTransitionActor")
  pricingPoliciesUpdated         ProductPricingPolicy[]     @relation("PricingPolicyUpdatedBy")
  priceListsCreated              PriceList[]                @relation("PriceListCreatedBy")
  pricingRulesCreated            CustomerPricingRule[]      @relation("CustomerRuleCreatedBy")
  workItemPricesSet              WorkItemPrice[]            @relation("WorkItemPriceSetBy")
  pricingStatusesUpdated         PricingStatus[]            @relation("PricingStatusUpdatedBy")
  // --- 052-finance reverse relations ---
  paymentsRecorded               Payment[]                  @relation("PaymentRecordedBy")
  financeVoided                  FinanceVoid[]              @relation("FinanceVoidedBy")
  expensesCreated                Expense[]                  @relation("ExpenseCreatedBy")
  expensesApproved               ExpenseApproval[]          @relation("ExpenseApprovedBy")
  directCostsCreated             DirectCost[]               @relation("DirectCostCreatedBy")
  creditsUpdated                 CustomerCredit[]           @relation("CustomerCreditUpdatedBy")
  financeConfigUpdates           FinanceConfig[]            @relation("FinanceConfigUpdatedBy")
  // --- 053-notifications reverse relations ---
  notifications                  Notification[]             @relation("NotificationRecipient")
  thresholdUpdates               DelayThreshold[]           @relation("DelayThresholdUpdatedBy")
  recipientOverrideUpdates       NotificationTypeOverride[] @relation("NotificationTypeOverrideUpdatedBy")

  // --- Reverse relations to change-control.prisma (016-change-control) ---
  specVersionsCreated        SpecVersion[]      @relation("SpecVersionCreatedBy")
  changeRequestsRequested    ChangeRequest[]    @relation("ChangeRequestRequestedBy")
  changeRequestsDecided      ChangeRequest[]    @relation("ChangeRequestDecidedBy")
  changeRequestsAcknowledged ChangeRequest[]    @relation("ChangeRequestAcknowledgedBy")
  lateCancellations          LateCancellation[] @relation("LateCancellationCreatedBy")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String? //@db.Text
  userAgent String? //@db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String //@db.Text
  providerId            String //@db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String? //@db.Text
  refreshToken          String? //@db.Text
  idToken               String? //@db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String? //@db.Text
  password              String? //@db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String //@db.Text
  value      String //@db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

// ---------------------------------------------------------------------------
// RBAC models — 001-identity-access-audit
// ---------------------------------------------------------------------------

/// A named, seeded bundle of Permission keys. Seeded once from PRD §48's
/// role × permission matrix; editing the matrix is out of scope (spec
/// Assumptions) — per-user extra grants use UserPermission instead (FR-014).
model Role {
  id        String   @id @default(cuid())
  /// Stable code identifier matching the RoleKey union in permissions.ts.
  /// e.g. "RECEPTION", "ADMIN_OWNER". Used in seed and in Actor.roles.
  key       String   @unique
  /// Human-readable display name shown in the Admin Roles screen.
  name      String
  createdAt DateTime @default(now())

  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("role")
}

/// Junction: one permission key granted to one Role.
/// The permission value is one of the 21 fixed keys from the Permission union
/// (permissions.ts) — stored as a plain String so adding a new key never
/// requires a migration to this table's schema, only to permissions.ts and
/// the seed (constitution VI).
model RolePermission {
  id         String @id @default(cuid())
  roleId     String
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  /// One of the 22 fixed Permission union keys (FR-010). Validated at the
  /// application layer (Zod), not as a DB enum.
  permission String

  @@unique([roleId, permission])
  @@map("role_permission")
}

/// Junction: a User holds a Role. A user may hold multiple roles; their
/// effective permission set is the union of all assigned roles' permissions
/// plus any UserPermission extras (FR-012).
model UserRole {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_role")
}

/// Per-user extra permission beyond what the user's Role(s) grant (FR-014).
/// Supports PRD §26's requirement: e.g. one Accounting user gaining
/// `pricing.set_variable` without making it role-wide for all Accounting.
model UserPermission {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// One of the 22 fixed Permission union keys (FR-010).
  permission  String
  /// The Admin who granted this extra permission. Itself audited via
  /// audit.record() at grant time (FR-022 role.changed event).
  grantedById String
  grantedBy   User     @relation("PermissionGrantedBy", fields: [grantedById], references: [id])
  createdAt   DateTime @default(now())

  @@unique([userId, permission])
  @@map("user_permission")
}

/// Junction: a User is a member of a Department. Scopes department-sensitive
/// permission checks — e.g. production.operate is only valid for the
/// departments the acting user is a member of (FR-017).
/// Department is defined in core.prisma; cross-file relations work transparently
/// with Prisma's prismaSchemaFolder feature (research.md).
model UserDepartment {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  @@unique([userId, departmentId])
  @@map("user_department")
}

/// Append-only audit log. The only writer is audit.record() inside the
/// caller's transaction (constitution III, FR-019, FR-020). UPDATE and DELETE
/// are revoked at the Postgres role level (FR-021 — see
/// prisma/manual-sql/audit-event-append-only.sql).
model AuditEvent {
  id            String   @id @default(cuid())
  /// Nullable: omit only for system-originated events (e.g. login.failure on
  /// an unknown username where no User row can be identified — spec Edge Cases).
  actorId       String?
  actor         User?    @relation(fields: [actorId], references: [id])
  /// Conventionally "entity.verb", e.g. "user.created", "login.failure".
  action        String
  /// e.g. "User", "WorkItem", "Order".
  entityType    String
  /// The affected record's ID.
  entityId      String
  /// Full snapshot pre-change (snapshots, not diffs — research.md).
  before        Json?
  /// Full snapshot post-change.
  after         Json?
  /// Required by the application layer (not the schema) for override-class
  /// actions (FR-024). Schema does not enforce presence — callers do.
  reason        String?
  /// References only — the actual files live in feature 050 (FR-020).
  attachmentIds String[]
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  // Indexes support the Admin Audit Log viewer's filter axes (FR-023).
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_event")
}

// 053-notifications — additive schema (data-model.md).
//
// Six new tables, plus the processing columns on 002's `NotificationEvent`
// (that model itself stays in core.prisma; only this feature writes those
// columns — 002's contract reserves them for 053).
//
// The two constraints that make the spec's hard guarantees *structural*
// rather than conventional — never "optimize away":
//   - Notification @@unique([sourceEventId, userId])   → FR-007, SC-002
//   - DelayBreach  @@unique([workItemId, phase, breachSequence]) → SC-003
//
// Additive only. No table here shadows or replaces an existing model's
// source of truth: a Notification is a *pointer* to an event, and delay
// state is derived from PhaseTiming / PricingStatus, never stored
// (constitution III, FR-059, FR-060).

/// Outbox processing marker. PENDING / PROCESSED / FAILED / UNMAPPED.
///
/// PENDING and PROCESSED are opposite answers to "was this event delivered?"
/// on the SAME column — that is why 053 reuses 002's already-reserved
/// `deliveryStatus` rather than adding a parallel pair, which would leave
/// two columns each claiming to answer it (A-001, research.md §Decision: the
/// outbox's own reserved columns).
enum DeliveryStatus {
  PENDING
  PROCESSED
  FAILED
  UNMAPPED
}

/// Visual weight of a notification. Drives how a row is drawn, never who it
/// is delivered to and never what order anything happens in.
enum NotificationSeverity {
  INFO
  ACTION
  URGENT
}

enum SchedulerOutcome {
  RUNNING
  OK
  ERROR
}

/// One row per (outbox event, recipient).
model Notification {
  id String @id @default(cuid())

  /// The bell's read axis and the page's scope axis. Every read path filters
  /// on this; a user may only ever see their own rows (FR-025).
  userId String
  user   User   @relation("NotificationRecipient", fields: [userId], references: [id])

  /// The outbox row that produced this. Retained, not cascaded: a notification
  /// outlives the event it points at, and the event is the audit trail.
  sourceEventId String
  sourceEvent   NotificationEvent @relation(fields: [sourceEventId], references: [id])

  /// Canonical catalog type — never a raw emitter string, so a type filter
  /// on the page behaves the same regardless of which spelling 012/013/014
  /// used (FR-011, research.md §4).
  type String

  // --- write-once content (FR-018) --------------------------------------
  // Captured at processing time, not re-derived on read. A notification is a
  // statement about a moment: a later change to the Work Item or an edit to
  // the catalog must never rewrite what an employee was already told.
  title      String
  body       String?
  /// Deep link resolved at processing time; null when the entry has no
  /// target or the target has since left the reader's scope (FR-022, FR-025).
  linkHref   String?
  /// Mirrors the event's entity. Polymorphic, so deliberately not a relation.
  entityType String?
  entityId   String?

  severity NotificationSeverity

  // --- the only mutable columns ------------------------------------------
  /// null = unread. The bell counts `readAt IS NULL` (FR-014).
  readAt     DateTime?
  /// Archival only (FR-024). Never a hard delete — constitution III.
  archivedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([sourceEventId, userId])
  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([userId, type, createdAt(sort: Desc)])
  @@index([sourceEventId])
  @@index([userId])
  @@map("notification")
}

/// FR-017: the per-catalog-type recipient redirect that makes delivery
/// configuration rather than code.
///
/// SEMANTICS (data-model.md §NotificationTypeOverride): this is a UNION
/// with the catalog default, never a replacement. A non-empty array *adds*
/// recipients; it cannot remove the catalog's own. Clearing an override is a
/// DELETE of this row, never an empty array — under union semantics an empty
/// array is indistinguishable from "no override".
model NotificationTypeOverride {
  id String @id @default(cuid())

  /// Canonical catalog type (never an alias, never a raw emitter string).
  /// An override for a type with no catalog entry is a VALIDATION error, not
  /// a dormant row (contract §setRecipientOverride).
  type String @unique

  userIds       String[] @default([])
  roles         String[] @default([])
  departmentIds String[] @default([])
  permissions   String[] @default([])

  /// Null until the first Admin write (seeded/absent rows have no editor).
  updatedById String?
  updatedBy   User?   @relation("NotificationTypeOverrideUpdatedBy", fields: [updatedById], references: [id])

  updatedAt DateTime @updatedAt

  @@map("notification_type_override")
}

/// Per-phase alerting configuration. One row per phase (FR-035); seeded by
/// the migration from config/053-notifications.yaml; editable by an Admin
/// through /admin/notifications (constitution VI).
model DelayThreshold {
  id String @id @default(cuid())

  phase DelayPhase @unique

  /// null disables the phase — no breach is ever detected for it.
  /// Backed by a DB CHECK as well as Zod (data-model.md §Migration notes).
  thresholdMinutes Int?

  alertRoles         String[] @default([])
  alertPermissions   String[] @default([])
  alertDepartmentIds String[] @default([])

  /// Accepted and stored but inactive in V1 (FR-047): null = no escalation
  /// tier. Must exceed thresholdMinutes when both are set.
  escalationMinutes Int?

  updatedById String?
  updatedBy   User?   @relation("DelayThresholdUpdatedBy", fields: [updatedById], references: [id])

  updatedAt DateTime @updatedAt

  @@map("delay_threshold")
}

/// The five measured phases. A fixed code vocabulary, NOT Admin-configurable
/// data: a new *threshold* is a row, but a new *axis to measure* needs a new
/// age source and a new derivation rule, so it is a code change. Same
/// reasoning as 001's frozen permission keys (constitution VI).
enum DelayPhase {
  DESIGN
  REVIEW
  PRICING
  PRODUCTION
  COLLECTION
}

/// One row per (Work Item, phase, breach occurrence). The unique triple is
/// what makes "one alert per breach, not one per tick" a schema property:
/// the scheduler's second tick over an unchanged breach attempts an insert
/// that already exists, and the catch is the duplicate alert's only defence
/// (SC-003, research.md §Decision: DelayBreach is a persisted fact).
model DelayBreach {
  id String @id @default(cuid())

  workItemId String
  workItem   WorkItem @relation(fields: [workItemId], references: [id])

  phase DelayPhase

  /// 1 for the first breach of this (workItem, phase); increments when the
  /// Work Item leaves the phase and returns (FR-044).
  breachSequence Int

  /// Snapshot of the threshold in force when the breach happened, so
  /// lowering a threshold later does not rewrite what the alert said.
  thresholdMinutes Int

  escalated   Boolean   @default(false)
  escalatedAt DateTime?

  /// Set in the SAME transaction that creates the alert rows (FR-042/043).
  /// A breach with no notification is legitimate and specified: a phase whose
  /// recipient arrays are all empty.
  notifiedAt DateTime?

  detectedAt DateTime @default(now())

  @@unique([workItemId, phase, breachSequence])
  @@index([workItemId, phase])
  @@map("delay_breach")
}

/// Operational telemetry for one scheduler tick. Append-only in practice: a
/// row is inserted at start and completed in place.
///
/// Unlike Notification and DelayBreach this is transient telemetry rather than
/// an operational record, so in-place completion and a retention cleanup are
/// both acceptable — explicitly NOT subject to FR-024, which governs
/// notifications (data-model.md §SchedulerRun).
model SchedulerRun {
  id String @id @default(cuid())

  /// The process instance (hostname/pid/boot id). Carries the identity 001's
  /// `AuditEvent.actorId` cannot express, since a tick has no signed-in user.
  ownerId String

  startedAt  DateTime         @default(now())
  finishedAt DateTime?
  outcome    SchedulerOutcome @default(RUNNING)

  evaluated Int @default(0)
  flagged   Int @default(0)
  alerted   Int @default(0)
  escalated Int @default(0)

  error String?

  @@index([startedAt(sort: Desc)])
  @@map("scheduler_run")
}

/// The persisted mutex guarding `runDelayTick()`. Exactly one row, created by
/// the migration (research.md §Decision: both idempotency layers).
///
/// This is the one table 053 legitimately mutates on every tick — it is a
/// lock, not a record. Acquired by a single conditional UPDATE, so two
/// instances racing produce exactly one winner.
model SchedulerLease {
  id String @id

  ownerId    String
  acquiredAt DateTime
  expiresAt  DateTime
}

// 051 Pricing Engine — historical price configuration and WorkItem pricing state.

enum PricingMode {
  FIXED
  VARIABLE
}

enum PricingUnit {
  PIECE
  SQUARE_METER
  LINEAR_METER
  SHEET
  PACK
}

enum PriceSource {
  LIST
  CUSTOMER_RULE
  MANUAL
}

enum PricingStatusValue {
  PENDING
  PRICED
  DISPUTED
}

enum CustomerRuleKind {
  FIXED
  PERCENT_DISCOUNT
}

enum PriceConfigStatus {
  ACTIVE
  RETIRED
}

model ProductPricingPolicy {
  id            String      @id @default(cuid())
  productTypeId String      @unique
  productType   ProductType @relation(fields: [productTypeId], references: [id])
  mode          PricingMode
  updatedById   String
  updatedBy     User        @relation("PricingPolicyUpdatedBy", fields: [updatedById], references: [id])
  updatedAt     DateTime    @updatedAt
}

model PriceList {
  id            String            @id @default(cuid())
  productTypeId String
  productType   ProductType       @relation(fields: [productTypeId], references: [id])
  unit          PricingUnit
  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        PriceConfigStatus @default(ACTIVE)
  createdById   String
  createdBy     User              @relation("PriceListCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime          @default(now())
  tiers         PriceTier[]

  @@index([productTypeId, unit, effectiveFrom, effectiveTo])
  @@index([status, effectiveFrom, effectiveTo])
}

model PriceTier {
  id              String    @id @default(cuid())
  priceListId     String
  priceList       PriceList @relation(fields: [priceListId], references: [id])
  minimumQuantity Int
  maximumQuantity Int?
  basePrice       Decimal   @db.Decimal(12, 2)

  @@index([priceListId, minimumQuantity, maximumQuantity])
}

model CustomerPricingRule {
  id              String            @id @default(cuid())
  customerId      String
  customer        Customer          @relation(fields: [customerId], references: [id])
  productTypeId   String
  productType     ProductType       @relation(fields: [productTypeId], references: [id])
  unit            PricingUnit
  kind            CustomerRuleKind
  fixedPrice      Decimal?          @db.Decimal(12, 2)
  discountPercent Decimal?          @db.Decimal(5, 2)
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  status          PriceConfigStatus @default(ACTIVE)
  createdById     String
  createdBy       User              @relation("CustomerRuleCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime          @default(now())

  @@index([customerId, productTypeId, unit, effectiveFrom, effectiveTo])
  @@index([status, effectiveFrom, effectiveTo])
}

model WorkItemPrice {
  id              String      @id @default(cuid())
  workItemId      String
  workItem        WorkItem    @relation(fields: [workItemId], references: [id])
  amount          Decimal     @db.Decimal(12, 2)
  currency        String      @default("EGP")
  source          PriceSource
  quoteBreakdown  Json?
  setById         String
  setBy           User        @relation("WorkItemPriceSetBy", fields: [setById], references: [id])
  setAt           DateTime    @default(now())
  reason          String?
  specFingerprint String?
  replacedAt      DateTime?

  @@index([workItemId, setAt])
  @@index([workItemId, replacedAt])
}

model PricingStatus {
  workItemId     String             @id
  workItem       WorkItem           @relation(fields: [workItemId], references: [id])
  status         PricingStatusValue @default(PENDING)
  waitingSince   DateTime?
  disputeReason  String?
  currentPriceId String?
  updatedById    String?
  updatedBy      User?              @relation("PricingStatusUpdatedBy", fields: [updatedById], references: [id])
  updatedAt      DateTime           @updatedAt

  @@index([status, waitingSince])
}

// Prisma schema root — multi-file schema (prismaSchemaFolder preview feature).
// This file holds only the generator and datasource blocks. Domain models live
// in sibling files under prisma/schema/ (identity.prisma, core.prisma, ...).
// learn more: https://www.prisma.io/docs/orm/prisma-schema/overview/location#multi-file-prisma-schema

generator client {
  provider        = "prisma-client-js"
  output          = "../../generated/prisma"
  // relationJoins (092-performance AC-005): lets getActorForSession load the
  // whole RBAC graph with relationLoadStrategy:"join" — one statement instead
  // of four. Client-generation flag only; NO database/DDL effect.
  previewFeatures = ["prismaSchemaFolder", "relationJoins"]
  binaryTargets   = ["native", "darwin-arm64", "windows", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase's pooled connection (DATABASE_URL, port 6543) is PgBouncer in
  // transaction mode, which cannot grant the advisory locks/prepared
  // statements `prisma db push`/`migrate` need — without directUrl those
  // commands hang indefinitely waiting on a lock the pooler can never grant.
  // DIRECT_URL (port 5432) bypasses the pooler for migration-time only.
  directUrl = env("DIRECT_URL")
}
