// Core domain models — the Order → WorkItem canonical model (constitution I).
// Source of truth: specs/002-core-domain-shell/data-model.md
// Relations to `User` (identity.prisma) work directly across schema files —
// Prisma's multi-file schema (prismaSchemaFolder) requires no import.

// --- Enums -----------------------------------------------------------------

enum WorkItemState {
  NEW
  ASSIGNED
  IN_DESIGN
  DESIGN_COMPLETED
  WAITING_REVIEW
  REWORK_REQUIRED
  APPROVED
  WAITING_PRICING
  READY_FOR_PRODUCTION
  IN_PRODUCTION
  PRODUCTION_COMPLETED
  READY_FOR_COLLECTION
  DELIVERED
  COMPLETED
  CANCELLED
}

enum OrderChannel {
  WALK_IN
  WHATSAPP
  PHONE
  RETURNING
  DIRECT_TO_DESIGNER
}

enum OrderPriority {
  NORMAL
  URGENT
}

enum OrderMode {
  GROUPED
  SEPARATE
}

enum PhaseTimingKind {
  QUEUE
  ACTIVE
}

enum RejectionCategory {
  DESIGN_ISSUE
  DIMENSION_ISSUE
  CUSTOMER_CHANGE
  PRICING_ISSUE
  ACCOUNTING_ISSUE
  PRODUCTION_ISSUE
  MISSING_INFORMATION
  OTHER
}

enum WorkItemDimensionUnit {
  MM
  CM
  M
  IN
}

enum ReturnAttachmentKind {
  VOICE_NOTE
  IMAGE
  FILE
}

/// 093-order-production-workflow. Lifecycle of a width above the configured
/// production maximum (FR-003). An over-maximum width is NEVER clamped — it
/// is refused and, when a manager still wants the job, recorded here as an
/// explicit, audited exception (constitution II: no silent bypass).
enum WidthExceptionStatus {
  PENDING
  APPROVED
  REJECTED
}

// --- Models ------------------------------------------------------------

/// Admin-configured production department (constitution VI: data, not an enum).
model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  /// Configured flag (constitution VI), not a hardcoded department-name
  /// check (014 research.md §5, US6).
  isExternalProduction Boolean @default(false)

  workItems       WorkItem[]
  returns         Return[]
  // Back-relation for 001-identity-access-audit's UserDepartment join
  // (identity.prisma). Cross-file relations work transparently with
  // prismaSchemaFolder — no import needed.
  userDepartments UserDepartment[]
  // Back-relation for 011-orders-reception's ProductType.defaultDepartmentId.
  productTypes    ProductType[]
}

model Customer {
  id               String   @id @default(cuid())
  name             String
  normalizedName   String   @default("")
  nationalId       String?
  notes            String?
  isCashCustomer   Boolean  @default(false)
  isArchived       Boolean  @default(false)
  classificationId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orders         Order[]
  phones         CustomerPhone[]
  addresses      CustomerAddress[]
  classification CustomerClassification? @relation(fields: [classificationId], references: [id])
  promotionsFrom CustomerPromotion[]     @relation("PromotionSource")
  promotionsTo   CustomerPromotion[]     @relation("PromotionTarget")
  pricingRules   CustomerPricingRule[]
  // --- 052-finance reverse relations ---
  payments       Payment[]
  customerCredit CustomerCredit?

  @@index([normalizedName])
  @@index([isArchived])
}

model Order {
  id          String        @id @default(cuid())
  /// DB sequence, ever-increasing, no reset, no prefix (FR-008a).
  number      Int           @unique @default(autoincrement())
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])
  channel     OrderChannel
  priority    OrderPriority
  mode        OrderMode
  /// Optional default due date for any Work Item on this order that has no
  /// due date of its own set (011 spec FR-003a).
  dueDate     DateTime?
  /// Order-level discount in whole EGP, agreed by reception. Never negative and
  /// never larger than the order's own production subtotal — both are enforced
  /// in `createMasterOrderAction`, not by a CHECK constraint, so the refusal
  /// reaches the receptionist as a message instead of a 500.
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  /// Order-level tax in whole EGP, agreed by reception. Added AFTER the
  /// discount, matching the sequence the receptionist sees on screen.
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  /// How the discount was arrived at — a flat sum or a percentage of the
  /// subtotal. Kept because the amount alone loses the shape of the deal:
  /// "150.00" could be a flat 150 or 10% of 1500. `NULL` when no discount was
  /// agreed. Built server-side from the kind, never free text.
  discountNote   String?
  /// Same as `discountNote`, for the tax.
  taxNote        String?
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  workItems   WorkItem[]
  // --- 052-finance reverse relations ---
  payments    Payment[]
  expenses    Expense[]
  directCosts DirectCost[]

  // Status is NOT a column — see contracts/orders.md (deriveOrderStatus).

  @@index([customerId])
}

model WorkItem {
  id             String        @id @default(cuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id])
  /// Catalog owned by 011.
  productTypeId  String?
  productType    ProductType?  @relation(fields: [productTypeId], references: [id])
  departmentId   String?
  department     Department?   @relation(fields: [departmentId], references: [id])
  /// Written only by transitionWorkItem().
  state          WorkItemState
  requiresDesign Boolean       @default(true)
  requiresReview Boolean       @default(true)
  assigneeId     String?
  assignee       User?         @relation("WorkItemAssignee", fields: [assigneeId], references: [id])

  /// --- 011-orders-reception descriptive fields --------------------------
  description   String?
  quantity      Int?
  widthValue    Decimal?               @db.Decimal(10, 2)
  heightValue   Decimal?               @db.Decimal(10, 2)
  dimensionUnit WorkItemDimensionUnit?
  material      String?
  finishNotes   String?
  /// Per-item due date override — null means "use Order.dueDate" (FR-003a).
  dueDate       DateTime?
  /// --- end 011-orders-reception fields -----------------------------------

  /// --- 014-production fields ---------------------------------------------
  /// Set on completion (US4, FR-006/FR-007). Required by completeProduction();
  /// validated non-null and > 0 before the completion transition runs.
  producedQuantity      Int?
  /// Optional free-text notes recorded at completion.
  productionNotes       String?
  /// Non-null while a newer DesignVersion was approved during IN_PRODUCTION
  /// and the operator has not yet acknowledged it (US7, FR-013). Set by the
  /// approval path (013's approveDesign), cleared by acknowledgeFileRevision().
  /// research.md §4 — a plain field, not a guard.
  pendingFileRevisionAt DateTime?
  /// --- end 014-production fields -------------------------------------------

  /// --- 093-order-production-workflow: frozen production specification -----
  /// Everything below is an immutable SNAPSHOT taken by
  /// `production-spec.setProductionSpec` at reception time (FR-001…FR-010,
  /// FR-024). It is deliberately denormalized onto WorkItem — the same
  /// pattern 014 used for `producedQuantity`/`productionNotes` — because the
  /// audit requirement is "a later price-list or width-table change must
  /// never rewrite what a customer was quoted" (SC-006). Recomputing these
  /// columns from mutable configuration is a defect, not a feature.
  ///
  /// Canonical units (FR-005): widths cm, heights m, area m².
  /// `customerWidthCm` is what the customer asked for and is NEVER
  /// overwritten by rounding; `productionWidthCm` is the rounded-up width
  /// that production actually consumes and the ONLY width that feeds area.
  customerWidthCm   Decimal? @db.Decimal(10, 2)
  productionWidthCm Decimal? @db.Decimal(10, 2)
  productionHeightM Decimal? @db.Decimal(10, 2)
  quantitySnapshot  Int?
  productionAreaSqm Decimal? @db.Decimal(12, 4)
  /// EGP per m² chosen at quote time; frozen so history never moves (FR-007).
  baseRatePerSqm    Decimal? @db.Decimal(12, 2)
  baseTotal         Decimal? @db.Decimal(12, 2)
  finishingTotal    Decimal? @db.Decimal(12, 2)
  /// `baseTotal + finishingTotal`, whole-EGP rounded once at the end (FR-008).
  productionTotal   Decimal? @db.Decimal(12, 2)
  /// When the snapshot above was written. Null = never priced.
  productionSpecAt  DateTime?
  /// --- end 093-order-production-workflow fields ---------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// --- 016-change-control ------------------------------------------------
  /// Current SpecVersion. Nullable only for the circular insert and the
  /// window before backfill (research.md §14); non-null for every Work Item
  /// after backfill (verified by query + contract test).
  currentSpecVersionId String?        @unique
  currentSpecVersion   SpecVersion?   @relation("WorkItemCurrentSpecVersion", fields: [currentSpecVersionId], references: [id])
  specVersions         SpecVersion[]  @relation("WorkItemSpecVersions")
  changeRequests       ChangeRequest[]
  lateCancellation     LateCancellation?
  /// --- end 016-change-control ---------------------------------------------

  transitions             WorkItemTransition[]
  phaseTimings            PhaseTiming[]
  designVersions          DesignVersion[]
  returns                 Return[]
  vendorProductionRecords VendorProductionRecord[]
  fileAssets              FileAsset[]              @relation("FileAssetWorkItem")
  prices                  WorkItemPrice[]
  pricingStatus           PricingStatus?
  // --- 052-finance reverse relations ---
  expenses                Expense[]
  directCosts             DirectCost[]
  // --- 053-notifications reverse relation ---
  delayBreaches           DelayBreach[]
  // --- 093-order-production-workflow reverse relations ---
  finishings              WorkItemFinishing[]
  widthExceptions         WidthExceptionTicket[]
  accountingApprovals     AccountingApproval[]

  @@index([orderId, state])
  // Review queue (getReviewQueue) filters on `state` alone; My Queue /
  // designer workload / eligible-designers filter on `assigneeId` (+ state).
  // Neither was covered by the existing [orderId, state] index, so both were
  // sequential-scanning the full WorkItem table at this row count.
  @@index([state])
  @@index([assigneeId, state])
}

/// Admin-configured product catalog (constitution VI: data, not an enum).
/// Owned by 011. Referenced by WorkItem.productTypeId.
model ProductType {
  id                    String      @id @default(cuid())
  name                  String      @unique
  defaultDepartmentId   String?
  defaultDepartment     Department? @relation(fields: [defaultDepartmentId], references: [id])
  defaultRequiresDesign Boolean     @default(true)
  defaultRequiresReview Boolean     @default(true)
  /// Free-form hint string for 051 to interpret (e.g. "FIXED" | "VARIABLE"
  /// | "QUOTE") — stored opaquely, not validated against 051's vocabulary.
  pricingModeHint       String?
  isActive              Boolean     @default(true)
  createdAt             DateTime    @default(now())

  workItems            WorkItem[]
  specVersions         SpecVersion[] @relation("SpecVersionProductType")
  pricingPolicy        ProductPricingPolicy?
  priceLists           PriceList[]
  customerPricingRules CustomerPricingRule[]
  // --- 093-order-production-workflow -------------------------------------
  /// Non-null exactly when this ProductType is governed by the production
  /// specification (width ladder, height cap, base-rate band). This is the
  /// configuration switch the pipeline guards read: a Work Item whose
  /// ProductType has no rule keeps 011/014's pre-existing behaviour, and a
  /// governed one cannot skip the width/area/price/file/accountant gates.
  widthRule            ProductionWidthRule?
}

/// 093-order-production-workflow. Per-ProductType production constraints —
/// DATA, not code branches (constitution VI). Owns the ordered width ladder
/// that `production-spec/widths.resolveProductionWidth` rounds against, the
/// height ceiling, and the permitted EGP/m² band for the base rate.
///
/// The ladder is a scalar list rather than a child table on purpose: it is
/// an ordered, small, all-or-nothing set that is replaced wholesale by
/// `configureWidthRule` inside one audited transaction. A child table would
/// need a delete-and-reinsert (a hard delete, which constitution III
/// forbids) or a versioning scheme that buys nothing for eight numbers.
model ProductionWidthRule {
  id            String      @id @default(cuid())
  productTypeId String      @unique
  productType   ProductType @relation(fields: [productTypeId], references: [id])
  /// Ascending, strictly increasing, whole centimetres. The last element is
  /// the maximum production width: anything above it raises a
  /// `WidthExceptionTicket` rather than clamping (FR-003).
  ladderCm      Int[]
  /// Maximum production height in metres (50 m for the seeded roll class).
  maxHeightM    Decimal     @db.Decimal(10, 2)
  /// Inclusive EGP/m² band the base rate must fall inside (80–120 seeded).
  minRatePerSqm Decimal     @db.Decimal(12, 2)
  maxRatePerSqm Decimal     @db.Decimal(12, 2)
  updatedById   String
  updatedBy     User        @relation("WidthRuleUpdatedBy", fields: [updatedById], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([productTypeId])
}

/// 093-order-production-workflow. An audited request to produce a banner
/// wider than the configured maximum. Raising one is how reception records
/// "the customer insists"; resolving one is how a manager authorises it.
///
/// Append-only in spirit: the row is created once and only its
/// status/resolution fields are ever written, each by an explicit, audited
/// action. It is never deleted (constitution III).
model WidthExceptionTicket {
  id               String               @id @default(cuid())
  workItemId       String
  workItem         WorkItem             @relation(fields: [workItemId], references: [id])
  /// The width the customer asked for, in cm — preserved exactly as entered.
  requestedWidthCm Decimal              @db.Decimal(10, 2)
  /// The ceiling that was exceeded, snapshotted so the ticket still reads
  /// correctly after the ladder is reconfigured.
  maxWidthCm       Decimal              @db.Decimal(10, 2)
  reason           String
  status           WidthExceptionStatus @default(PENDING)
  raisedById       String
  raisedBy         User                 @relation("WidthExceptionRaisedBy", fields: [raisedById], references: [id])
  resolvedById     String?
  resolvedBy       User?                @relation("WidthExceptionResolvedBy", fields: [resolvedById], references: [id])
  resolutionNote   String?
  resolvedAt       DateTime?
  createdAt        DateTime             @default(now())

  @@index([status, createdAt])
  @@index([workItemId, createdAt])
}

/// 093-order-production-workflow. The accountant's sign-off. Its existence is
/// what the `-> READY_FOR_PRODUCTION` guard checks, which is how "only an
/// accountant can put work in front of the printer" is enforced in the one
/// authoritative transition function rather than in UI code (FR-014/FR-015,
/// SC-003).
///
/// Append-only (constitution III): a corrected approval is a new row, never
/// an update. Revoking an approval is a `Return`/rework, not a delete.
model AccountingApproval {
  id           String   @id @default(cuid())
  workItemId   String
  workItem     WorkItem @relation(fields: [workItemId], references: [id])
  approvedById String
  approvedBy   User     @relation("AccountingApprovalApprovedBy", fields: [approvedById], references: [id])
  /// The frozen `WorkItemPrice` the accountant signed off, when one exists.
  priceId      String?
  /// EGP total at approval time — a copy, not a lookup, so the approval keeps
  /// its meaning even if the price is later superseded (FR-007, SC-006).
  totalAmount  Decimal  @db.Decimal(12, 2)
  note         String?
  approvedAt   DateTime @default(now())

  @@index([workItemId, approvedAt])
}

/// Immutable — application code never updates or deletes a row here (constitution III).
model WorkItemTransition {
  id                String             @id @default(cuid())
  workItemId        String
  workItem          WorkItem           @relation(fields: [workItemId], references: [id])
  from              WorkItemState
  to                WorkItemState
  actorId           String
  actor             User               @relation("WorkItemTransitionActor", fields: [actorId], references: [id])
  at                DateTime           @default(now())
  /// Required by the caller for REWORK_REQUIRED and CANCELLED edges
  /// (enforced in transitionWorkItem, not the schema).
  reason            String?
  /// Set only on edges landing in REWORK_REQUIRED; drives the landing-state
  /// choice (FR-003b).
  rejectionCategory RejectionCategory?
  meta              Json?

  @@index([workItemId, at])
}

/// Timestamped segments, not a stopwatch (constitution III, FR-009).
model PhaseTiming {
  id         String          @id @default(cuid())
  workItemId String
  workItem   WorkItem        @relation(fields: [workItemId], references: [id])
  /// Which state this timing segment belongs to.
  phase      WorkItemState
  /// Null for QUEUE segments (nobody "actively" queues).
  userId     String?
  user       User?           @relation("PhaseTimingUser", fields: [userId], references: [id])
  kind       PhaseTimingKind
  startedAt  DateTime
  /// Null while the segment is open; pausing sets this, resuming starts a
  /// new segment (spec FR-009).
  endedAt    DateTime?

  @@index([workItemId, phase, kind])
}

/// A single uploaded design file version for a Work Item (constitution IV:
/// "new version, never overwritten in place"). Bytes live in the existing
/// StorageAdapter (002); this table is metadata only. Owned by 012.
model DesignVersion {
  id           String   @id @default(cuid())
  workItemId   String
  workItem     WorkItem @relation(fields: [workItemId], references: [id])
  /// 1, 2, 3... per Work Item — never reused, never decremented.
  version      Int
  /// Opaque key passed to StorageAdapter.put/get — no folder/filename
  /// semantics assumed by application code (constitution IV).
  storageKey   String
  fileName     String
  mimeType     String?
  sizeBytes    Int
  sha256       String
  /// Short note the designer attaches (e.g. "v2 — updated logo size").
  note         String?
  uploadedById String
  uploadedBy   User     @relation("DesignVersionUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  /// Set once by 013's approveDesign; never cleared (constitution IV).
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?     @relation("DesignVersionApprovedBy", fields: [approvedById], references: [id])

  returns Return[]

  @@unique([workItemId, version])
  @@index([workItemId, createdAt])
}

/// Generic "sent back" record — 013's own rejection flow creates one, and
/// 014/051 are expected to reuse this same shape for non-review returns
/// (spec.md User Story 6). Immutable — no application code path updates or
/// deletes a row here (constitution III).
model Return {
  id                 String            @id @default(cuid())
  workItemId         String
  workItem           WorkItem          @relation(fields: [workItemId], references: [id])
  raisedById         String
  raisedBy           User              @relation("ReturnRaisedBy", fields: [raisedById], references: [id])
  originDepartmentId String
  originDepartment   Department        @relation(fields: [originDepartmentId], references: [id])
  category           RejectionCategory
  assignedToId       String
  assignedTo         User              @relation("ReturnAssignedTo", fields: [assignedToId], references: [id])
  explanation        String
  note               String?
  /// Nullable — only set when raised from 013's own design-review rejection
  /// flow; a future 014/051-originated return has no design version.
  designVersionId    String?
  designVersion      DesignVersion?    @relation(fields: [designVersionId], references: [id])
  createdAt          DateTime          @default(now())

  attachments   ReturnAttachment[]
  changeRequest ChangeRequest?

  @@index([workItemId, createdAt])
}

model ReturnAttachment {
  id         String               @id @default(cuid())
  returnId   String
  return     Return               @relation(fields: [returnId], references: [id])
  kind       ReturnAttachmentKind
  /// Opaque key passed to StorageAdapter.put/get (constitution IV).
  storageKey String
  fileName   String
  mimeType   String?
  sizeBytes  Int
  createdAt  DateTime             @default(now())

  @@index([returnId])
}

/// One row per external-production cycle, not two separate sent/received
/// event rows (014 research.md §5) — completion's gate check needs a single
/// queryable row testing `receivedAt IS NOT NULL`.
model VendorProductionRecord {
  id          String    @id @default(cuid())
  workItemId  String
  workItem    WorkItem  @relation(fields: [workItemId], references: [id])
  vendorName  String
  sentAt      DateTime  @default(now())
  /// Null until recordReceivedFromVendor() runs; completeProduction() MUST
  /// refuse completion while this is null for a Work Item routed to an
  /// external-production department (FR-012).
  receivedAt  DateTime?
  createdById String
  createdBy   User      @relation("VendorProductionRecordCreatedBy", fields: [createdById], references: [id])

  @@index([workItemId])
}

/// Outbox — polymorphic via entityType/entityId, not a Prisma relation.
model NotificationEvent {
  id                     String    @id @default(cuid())
  /// Event type discriminator, e.g. "work_item.rejected".
  type                   String
  entityType             String
  entityId               String
  recipientUserIds       String[]
  recipientRoles         String[]
  recipientDepartmentIds String[]
  payload                Json?
  createdAt              DateTime  @default(now())
  /// Set once when 053 has fully processed this event; null = unprocessed.
  /// 002 reserved this column for 053; 053 reuses it rather than adding a
  /// parallel marker, so one row has exactly one answer to "was this
  /// delivered?" (003-free — see specs/053-notifications/data-model.md
  /// §NotificationEvent, A-001).
  deliveredAt            DateTime?
  /// PENDING / PROCESSED / FAILED / UNMAPPED. 002 shipped this as `String?`
  /// and never wrote it, so the retype is a safe ALTER (every existing row is
  /// NULL). The migration backfills NULL → PENDING BEFORE adding the claim
  /// index — without it the claim predicate silently skips every event the
  /// live features (012/013/014/015/016) have already recorded.
  deliveryStatus         DeliveryStatus?
  /// 053-only processing columns. No emitter writes these.
  attemptCount           Int       @default(0)
  lastAttemptAt          DateTime?
  lastError              String?
  /// Fourth addressing mode (FR-016, additive to 002's three).
  recipientPermissions   String[]  @default([])

  /// 053's notifications. The outbox row is the delivery audit trail and is
  /// retained after processing (FR-063), so this is a plain reference, never
  /// a cascade.
  notifications          Notification[]

  @@index([entityType, entityId])
  @@index([deliveredAt, deliveryStatus, createdAt])
  @@index([type, createdAt])
}
