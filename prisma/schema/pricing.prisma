// 051 Pricing Engine — historical price configuration and WorkItem pricing state.

enum PricingMode {
  FIXED
  VARIABLE
}

enum PricingUnit {
  PIECE
  SQUARE_METER
  LINEAR_METER
  SHEET
  PACK
}

enum PriceSource {
  LIST
  CUSTOMER_RULE
  MANUAL
}

enum PricingStatusValue {
  PENDING
  PRICED
  DISPUTED
}

enum CustomerRuleKind {
  FIXED
  PERCENT_DISCOUNT
}

enum PriceConfigStatus {
  ACTIVE
  RETIRED
}

model ProductPricingPolicy {
  id            String      @id @default(cuid())
  productTypeId String      @unique
  productType   ProductType @relation(fields: [productTypeId], references: [id])
  mode          PricingMode
  updatedById   String
  updatedBy     User        @relation("PricingPolicyUpdatedBy", fields: [updatedById], references: [id])
  updatedAt     DateTime    @updatedAt
}

model PriceList {
  id            String            @id @default(cuid())
  productTypeId String
  productType   ProductType       @relation(fields: [productTypeId], references: [id])
  unit          PricingUnit
  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        PriceConfigStatus @default(ACTIVE)
  createdById   String
  createdBy     User              @relation("PriceListCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime          @default(now())
  tiers         PriceTier[]

  @@index([productTypeId, unit, effectiveFrom, effectiveTo])
  @@index([status, effectiveFrom, effectiveTo])
}

model PriceTier {
  id              String    @id @default(cuid())
  priceListId     String
  priceList       PriceList @relation(fields: [priceListId], references: [id])
  minimumQuantity Int
  maximumQuantity Int?
  basePrice       Decimal   @db.Decimal(12, 2)

  @@index([priceListId, minimumQuantity, maximumQuantity])
}

model CustomerPricingRule {
  id              String            @id @default(cuid())
  customerId      String
  customer        Customer          @relation(fields: [customerId], references: [id])
  productTypeId   String
  productType     ProductType       @relation(fields: [productTypeId], references: [id])
  unit            PricingUnit
  kind            CustomerRuleKind
  fixedPrice      Decimal?          @db.Decimal(12, 2)
  discountPercent Decimal?          @db.Decimal(5, 2)
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  status          PriceConfigStatus @default(ACTIVE)
  createdById     String
  createdBy       User              @relation("CustomerRuleCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime          @default(now())

  @@index([customerId, productTypeId, unit, effectiveFrom, effectiveTo])
  @@index([status, effectiveFrom, effectiveTo])
}

model WorkItemPrice {
  id              String      @id @default(cuid())
  workItemId      String
  workItem        WorkItem    @relation(fields: [workItemId], references: [id])
  amount          Decimal     @db.Decimal(12, 2)
  currency        String      @default("EGP")
  source          PriceSource
  quoteBreakdown  Json?
  setById         String
  setBy           User        @relation("WorkItemPriceSetBy", fields: [setById], references: [id])
  setAt           DateTime    @default(now())
  reason          String?
  specFingerprint String?
  replacedAt      DateTime?

  @@index([workItemId, setAt])
  @@index([workItemId, replacedAt])
}

model PricingStatus {
  workItemId     String             @id
  workItem       WorkItem           @relation(fields: [workItemId], references: [id])
  status         PricingStatusValue @default(PENDING)
  waitingSince   DateTime?
  disputeReason  String?
  currentPriceId String?
  updatedById    String?
  updatedBy      User?              @relation("PricingStatusUpdatedBy", fields: [updatedById], references: [id])
  updatedAt      DateTime           @updatedAt

  @@index([status, waitingSince])
}

// ---------------------------------------------------------------------------
// 093-order-production-workflow — extensible finishing / add-on services.
//
// Modelled as configured DATA with the same shape as the rest of 051
// (PriceList / CustomerPricingRule: effective dates + ACTIVE|RETIRED), not as
// a `switch (code)` anywhere in the pricing path (FR-009). Adding "SULFAN",
// "EYELET", "HEMMING" or a service nobody has thought of yet is a row, not a
// deploy.
// ---------------------------------------------------------------------------

/// An add-on charged per square metre of PRODUCTION area. `SULFAN` ships at
/// 90 EGP/m² as seed data; the code is a business key, not a branch.
model FinishingService {
  id            String            @id @default(cuid())
  code          String            @unique
  /// Arabic-first display label (constitution IX); stored, never derived.
  labelAr       String
  ratePerSqm    Decimal           @db.Decimal(12, 2)
  effectiveFrom DateTime          @default(now())
  effectiveTo   DateTime?
  status        PriceConfigStatus @default(ACTIVE)
  createdById   String
  createdBy     User              @relation("FinishingServiceCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime          @default(now())

  selections WorkItemFinishing[]

  @@index([status, effectiveFrom, effectiveTo])
}

/// One finishing selected on one Work Item, with the rate and label FROZEN at
/// selection time. The snapshots are the whole point: a later rate change
/// must not retroactively alter what this job cost (FR-007, FR-010, SC-006).
///
/// Strictly append-only (constitution III): a re-price inserts a NEW
/// generation and leaves every earlier row untouched, so the composition of
/// each quote ever given to a customer remains reconstructible. That is why
/// there is deliberately no unique constraint on (workItemId,
/// finishingServiceId) — duplicates across generations are the point, and
/// duplicates WITHIN one quote are already impossible (`resolveFinishingRates`
/// de-duplicates the requested codes).
model WorkItemFinishing {
  id                 String           @id @default(cuid())
  workItemId         String
  workItem           WorkItem         @relation(fields: [workItemId], references: [id])
  finishingServiceId String
  finishingService   FinishingService @relation(fields: [finishingServiceId], references: [id])
  /// Which quote generation this row belongs to. `quotedAt` is the ordering
  /// key; the generation number is carried for display and for pairing rows
  /// written in the same transaction.
  generation         Int
  quotedAt           DateTime         @default(now())
  labelSnapshot      String
  rateSnapshot       Decimal          @db.Decimal(12, 2)
  /// `productionAreaSqm × rateSnapshot`, to 2 dp (FR-010).
  totalAmount        Decimal          @db.Decimal(12, 2)
  createdAt          DateTime         @default(now())

  @@index([workItemId, quotedAt])
}
